# --- Login ---------------------------------------------------------------
# One of the two. The hash is produced by: docker run --rm -it <image> python -m whitelister.hashpw
WHITELISTER_PASSWORD=change-me-to-at-least-12-characters
#WHITELISTER_PASSWORD_HASH=pbkdf2_sha256$600000$...
# Signs the session cookie. 32+ random characters; when unset a key is generated under /data.
#SESSION_SECRET=
SESSION_HOURS=12
LOGIN_MAX_FAILURES=3
LOGIN_LOCK_SECONDS=30

# --- Where requests come from --------------------------------------------
# Required. The reverse proxy's address(es) whose X-Forwarded-For is trusted, or "none" when clients
# connect directly. Name the BunkerWeb ingress alone (fixed address in the compose example), not a whole
# shared subnet: every host inside TRUSTED_PROXIES can choose the client identity it reports.
TRUSTED_PROXIES=10.20.30.2/32
#CLIENT_IP_HEADER=X-Forwarded-For
# Session cookie only over HTTPS (BunkerWeb terminates TLS). Only "no" for plain-HTTP tests.
COOKIE_SECURE=yes
# Send Strict-Transport-Security. Leave off when BunkerWeb already sets it.
HSTS=no

# --- The plain list BunkerWeb downloads ----------------------------------
# /ips.txt answers only direct requests (no forwarding headers) from these networks.
LIST_ALLOWED_NETWORKS=10.20.30.0/24
# Shared secret the scheduler sends as ?token=…; keep it in WHITELIST_IP_URLS (bw-scheduler) and
# WHITELIST_URL (below) byte-identical. Leave empty only if you accept subnet membership as the sole gate.
LIST_TOKEN=change-me-list-token

# --- Entry rules ---------------------------------------------------------
DURATION_PRESETS=1 7 14 30
MAX_DAYS=3650
# Expired entries stay visible (and extendable) this long before they are deleted.
EXPIRED_RETENTION_DAYS=7
MIN_PREFIX_V4=16
MIN_PREFIX_V6=48
ALLOW_PRIVATE=yes

# --- BunkerWeb API -------------------------------------------------------
BW_API_URL=http://bw-api:8888
# API user (admin not required): the credentials are exchanged for a Biscuit token at POST /auth.
# ACL permissions needed: cache_read, cache_delete, job_run.
BW_API_USERNAME=whitelister
BW_API_PASSWORD=change-me-too
#BW_API_TOKEN=
BW_API_VERIFY_TLS=yes
# Exactly the URL configured in WHITELIST_IP_URLS (including ?token=); it names the cache file that gets
# dropped. A mismatch is reported in the header as an API error after the first refresh.
WHITELIST_URL=http://whitelister:8080/ips.txt?token=change-me-list-token
SYNC_DEBOUNCE_SECONDS=3
SYNC_TIMEOUT_SECONDS=10

# --- Look and feel -------------------------------------------------------
# en or de (add whitelister/locales/<code>.json for more)
WHITELISTER_LANG=en
# auto, dark, amoled, sunset, light, mint, mango
WHITELISTER_SKIN=auto
TZ=Europe/Berlin
LOG_LEVEL=info
